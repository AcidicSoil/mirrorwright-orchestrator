{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "string",
      "required": false
    },
    "contextModifiers": {
      "type": "object",
      "additionalProperties": true,
      "required": false
    },
    "activeRituals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "required": true
    }
  }
}
