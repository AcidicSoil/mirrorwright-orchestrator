{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@jest/globals": [
        "node_modules/@jest/globals"
      ],
      "#tools/*": [
        "tools/*"
      ]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
