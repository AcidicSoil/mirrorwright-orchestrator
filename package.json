{
  "name": "mirrorwright-orchestrator",
  "version": "1.0.0",
  "description": "Protocol-driven multi-agent orchestration system",
  "scripts": {
    "dev": "ts-node-dev",
    "build": "tsc",
    "watch": "ts-node-dev --watch",
    "test": "vitest",
    "benchmark": "vitest bench",
    "validate:schema": "ts-node src/utils/validateSchema.ts",
    "validate": "ts-node tools/validateProtocol.ts",
    "validate:ritual": "ts-node tools/validateProtocol.ts --type ritual",
    "validate:mode": "ts-node tools/validateProtocol.ts --type mode",
    "validate:protocol": "ts-node tools/validateProtocol.ts --type protocol",
    "validate:all": "ts-node tools/validateProtocol.ts --type all"
  },
  "dependencies": {
    "@types/node": "^20.0.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "ajv-keywords": "^5.1.0",
    "chalk": "^4.1.2",
    "js-yaml": "^4.1.0",
    "pino": "^8.16.0",
    "pino-pretty": "^13.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vitest": "^0.30.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.7",
    "@types/js-yaml": "^4.0.5",
    "@types/pino": "^7.0.5",
    "pnpm": "^7.0.0",
    "strip-bom": "^3.0.0",
    "strip-json-comments": "^3.1.0"
  },
  "packageManager": "pnpm@9.8.0+sha512.8e4c3550fb500e808dbc30bb0ce4dd1eb614e30b1c55245f211591ec2cdf9c611cabd34e1364b42f564bd54b3945ed0f49d61d1bbf2ec9bd74b866fcdc723276"
}
